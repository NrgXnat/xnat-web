    function uploadData(templateId) {
        XNAT
            .dialog
            .open({
                width: 600,
                speed: 200,
                esc: true,
                enter: false,
                title: "Upload Data File Using Template",
                content: function () {
                    formContainer$ = $.spawn('csv-upload-container');
                    XNAT
                        .spawner
                        .spawn({templateNameForm: uploadDataContent()})
                        .render(formContainer$)
                    return formContainer$[0];
                },
                buttons: [
                    {
                        id:"upload-btn" ,
                        label: "Upload",
                        close: false,
                        isDefault: true,
                        action: function (obj) {
                            const projectID = obj.$dialog 
                                .find('.selectProject')[0]
                                .value;
                            const file = obj.$dialog.find('#csvFile')[0].files[0];
                            var formData = new FormData();
                            formData.append('file',file);
                            const uploadUrl = XNAT.url
                                .restUrl(`/xapi/csv/upload/projects/${projectID}/validate/${templateId}`)
                            const submitUrl = XNAT.url
                                .restUrl(`/xapi/csv/upload/projects/${projectID}/submit/${templateId}`)    
                            return XNAT.xhr.post({
                                url :uploadUrl,
                                data: formData,
                                enctype: 'multipart/form-data',
                                processData: false,  // Important!
                                contentType: false,
                                cache: false,
                                fail: function(e){
                                    console.log(e);
                                            
                                },
                                success: function(data){
                                    if(Array.isArray(data.error) && data.error.length){
                                        generateTable(data.error, 'upload-Data-form');
                                    }
                                    else{
                                        obj.close();
                                        dataConfirmation(data);
                                            
                                    }
                                }
                            })
                        }
                    } ,{
                        label: "Cancel",
                        close: true
                    }]
            });
    }

