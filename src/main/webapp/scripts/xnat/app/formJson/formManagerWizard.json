{
    "display": "wizard",
    "settings": {},
    "components": [
        {
            "key": "basicInfo",
            "type": "panel",
            "input": false,
            "label": "basicInfo",
            "title": "Step 1: Basic form information",
            "tableView": false,
            "components": [
                {
                    "key": "formTitle",
                    "type": "textfield",
                    "input": true,
                    "label": "Title of the form",
                    "widget": "choicesjs",
                    "validate": {
                        "required": true
                    },
                    "tableView": true,
                    "placeholder": "Enter a short title for your Form. This will help you identify it later."
                },
                {
                    "label": "Form Order: Relative form order is a preference set via integer values, where lower numbers reflect higher positions. If multiple forms have the same value, creation date is used as a tie breaker.",
                    "mask": false,
                    "tableView": false,
                    "delimiter": false,
                    "decimalLimit": 0,
                    "requireDecimal": false,
                    "inputFormat": "plain",
                    "truncateMultipleSpaces": false,
                    "key": "zIndex",
                    "type": "number",
                    "input": true,
                    "defaultValue": -1
                },
                {
                    "key": "xnatDatatype",
                    "data": {
                        "custom": "function fetchCreatableDatatypes(){var myValues =  XNAT.customFormManager.datatypeManager.createableElements; return myValues;} values=fetchCreatableDatatypes();"
                    },
                    "type": "select",
                    "input": true,
                    "label": "This form applies to the XNAT Datatype?",
                    "widget": "choicesjs",
                    "dataSrc": "custom",
                    "validate": {
                        "required": true
                    },
                    "tableView": true,
                    "placeholder": "Select"
                },
                {
                    "key": "isThisASiteWideConfiguration",
                    "type": "hidden",
                    "input": true,
                    "label": "Is this a site wide configuration?",
                    "inline": false,
                    "values": [
                        {
                            "label": "Yes",
                            "value": "yes",
                            "shortcut": ""
                        }
                    ],
                    "validate": {
                        "required": true
                    },
                    "tableView": false,
                    "defaultValue": "yes"
                }
            ],
            "collapsible": false,
            "saveOnEnter": false,
            "scrollToTop": false,
            "buttonSettings": {
                "next": true,
                "cancel": false,
                "previous": false
            },
            "navigateOnEnter": false,
            "breadcrumbSettings": {
                "clickable": false
            }
        },
        {
            "key": "buildForm",
            "type": "panel",
            "input": false,
            "label": "Build Form",
            "title": "Step 2: Build Form",
            "tableView": false,
            "components": [
                {
                    "key": "formBuilder",
                    "tag": "div",
                    "type": "htmlelement",
                    "attrs": [
                        {
                            "attr": "id",
                            "value": "form-builder"
                        },
                        {
                            "attr": "class",
                            "value": "xnat-bootstrap"
                        }
                    ],
                    "input": false,
                    "label": "Form Builder",
                    "tableView": false,
                    "refreshOnChange": false
                }
            ],
            "collapsible": false,
            "saveOnEnter": false,
            "scrollToTop": false,
            "buttonSettings": {
                "next": true,
                "previous": true
            },
            "navigateOnEnter": false,
            "breadcrumbSettings": {
                "clickable": false
            }
        }
    ]
}